    FINAL_FILE="/Users/adam/sandbox/prompts-context/context/pulumi_blog.content.md"
    (
        echo "---"
        echo "name: Pulumi Blog"
        echo "description: Full Pulumi Blog Content"
        echo "---"
        cat "$TEMP_FILE"
    ) > "$FINAL_FILE"
    rm "$TEMP_FILE"
    echo "Created $FINAL_FILE"
}

