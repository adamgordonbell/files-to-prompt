    TEMP_FILE="pulumi_docs_temp.md"
    run /Users/adam/sandbox/docs/content/docs --ignore "*.json" --ignore "*.svg" --ignore "*.png" --ignore "*.mp4" --ignore "*.jpg" --ignore "*.gif" --ignore "*.webp" --ignore "*.pdf" --ignore "*.jpeg" --ignore "*.mp3" > "$TEMP_FILE"
    
    FINAL_FILE="/Users/adam/sandbox/prompts-context/context/pulumi_docs.content.md"
    (
        echo "---"
        echo "name: Pulumi Docs"
        echo "description: Full Pulumi Docs"
        echo "---"
        cat "$TEMP_FILE"
    ) > "$FINAL_FILE"
    rm "$TEMP_FILE"
    echo "Created $FINAL_FILE"

